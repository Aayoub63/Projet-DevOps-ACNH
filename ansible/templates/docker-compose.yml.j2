version: '3.4'

# Les secrets (BDD, Grafana) sont lus dans le fichier .env généré par Ansible (droits 600).
# Ils ne sont plus écrits en clair dans ce fichier.

services:
  traefik:
    image: traefik:v3.6
    command:
      - "--configFile=/traefik.yaml"
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik.yaml:/traefik.yaml:ro
      - ./acme.json:/acme.json
    labels:
      - "traefik.enable=true"
    restart: unless-stopped

  backend:
    image: registry.edu.forestier.re/${PROJECT_NAMESPACE}/backend:${APP_VERSION}
    environment:
      - SPRING_DATASOURCE_URL=jdbc:mariadb://${MYSQL_HOST}:3306/${MYSQL_DATABASE_NAME}
      - SPRING_DATASOURCE_USERNAME=${MYSQL_USERNAME}
      - SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD}
      - SPRING_JPA_HIBERNATE_DDL_AUTO=update
      - SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=2
    labels:
      - "traefik.enable=true"
      # Middleware CORS pour autoriser le frontend à envoyer des requêtes POST/PUT vers l'API
      - "traefik.http.middlewares.cors-api.headers.accessControlAllowMethods=GET,POST,PUT,DELETE,OPTIONS"
      - "traefik.http.middlewares.cors-api.headers.accessControlAllowOriginList=https://{{ user_id_uca }}.uca-devops.ovh"
      - "traefik.http.middlewares.cors-api.headers.accessControlAllowHeaders=Origin, Content-Type, Accept, Authorization"
      - "traefik.http.middlewares.cors-api.headers.accessControlAllowCredentials=true"
      - "traefik.http.middlewares.cors-api.headers.accessControlMaxAge=100"
      - "traefik.http.middlewares.cors-api.headers.addVaryHeader=true"
      # Routage de l'API (uniquement en HTTPS)
      # Seul le port 8080 est routé : l'actuator (8081) reste interne au réseau Docker
      - "traefik.http.routers.backend.entrypoints=websecure"
      - "traefik.http.routers.backend.rule=Host(`api.{{ user_id_uca }}.uca-devops.ovh`)"
      - "traefik.http.routers.backend.tls=true"
      - "traefik.http.routers.backend.middlewares=cors-api@docker"
      - "traefik.http.routers.backend.tls.certResolver=letsencrypt"
      - "traefik.http.services.backend.loadbalancer.server.port=8080"
    restart: unless-stopped

  frontend:
    image: registry.edu.forestier.re/${PROJECT_NAMESPACE}/frontend:${APP_VERSION}
    labels:
      - "traefik.enable=true"
      # Routage du Frontend (uniquement en HTTPS)
      - "traefik.http.routers.frontend.entrypoints=websecure"
      - "traefik.http.routers.frontend.rule=Host(`{{ user_id_uca }}.uca-devops.ovh`)"
      - "traefik.http.routers.frontend.tls=true"
      - "traefik.http.routers.frontend.tls.certResolver=letsencrypt"
      - "traefik.http.services.frontend.loadbalancer.server.port=80"
    restart: unless-stopped

  prometheus:
    image: prom/prometheus:v2.55.1
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
    restart: unless-stopped

  grafana:
    image: grafana/grafana:11.3.0
    depends_on:
      - prometheus
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
      - GF_USERS_ALLOW_SIGN_UP=false
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.grafana.entrypoints=websecure"
      - "traefik.http.routers.grafana.rule=Host(`grafana.{{ user_id_uca }}.uca-devops.ovh`)"
      - "traefik.http.routers.grafana.tls=true"
      - "traefik.http.routers.grafana.tls.certResolver=letsencrypt"
      - "traefik.http.services.grafana.loadbalancer.server.port=3000"
    restart: unless-stopped

  node-exporter:
    image: prom/node-exporter:v1.8.2
    restart: unless-stopped
    pid: host
    volumes:
      - /:/host:ro,rslave
    command:
      - '--path.rootfs=/host'
