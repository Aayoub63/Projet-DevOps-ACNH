global:
  scrape_interval: 15s

scrape_configs:

  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']


  - job_name: 'node-exporter'
    static_configs:
      # Le DNS interne de Docker résout le nom du service, l'IP du conteneur peut changer
      - targets: ['node-exporter:9100']

  # Métriques de l'application Spring Boot (actuator sur le port 8081)
  - job_name: 'backend'
    metrics_path: /actuator/prometheus
    static_configs:
      - targets: ['backend:8081']
